<html>
<head>
    <title>Passenger</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<div id="errors"></div>
<div id="passenger-block"></div>
<script type="module">
    import {GetCookie, GetE} from "/assets/js/util.js";
    import {App} from "/assets/js/app.js";
    import {ClientType} from "/assets/js/constants.js";

    const app = new App();

    const passengerId = GetCookie("gt_taxi_id");

    const commonComponent = app.wireCommonComponent(ClientType.PASSENGER);
    const passengerComponent = app.wirePassengerComponent(passengerId);
    const chatComponent = app.wireChatComponent(passengerId, ClientType.PASSENGER);

    const passengerBlock = GetE("passenger-block");
    passengerBlock.appendChild(commonComponent.render());
    passengerBlock.appendChild( await passengerComponent.render());
    passengerBlock.appendChild(chatComponent.render());

    console.log("Passenger page loaded");

    app.getPassengerWs().startWsHandling();

</script>
</body>
</html>
