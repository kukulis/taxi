<html>
<head>
    <title>Driver</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<div id="errors"></div>
<div id="driver-block"></div>
<script type="module">
    import {GetCookie, GetE} from "/assets/js/util.js";
    import {App} from "/assets/js/app.js";
    import {ClientType} from "/assets/js/constants.js";

    const app = new App();

    const driverId = GetCookie("gt_taxi_id");

    const commonComponent = app.wireCommonComponent(ClientType.DRIVER);
    const driverComponent = app.wireDriverComponent(driverId);

    const driverBlock = GetE("driver-block");
    driverBlock.appendChild(commonComponent.render());
    driverBlock.appendChild( await driverComponent.render());

    console.log("Driver page loaded");

    app.getDriverWs().startWsHandling();

</script>
</body>
</html>
