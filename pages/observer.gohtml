<html>
<head>
    <title>Observer</title>
</head>
<body>
<h1>Observer</h1>

<h2>Drivers (up to 5)</h2>
<table border="1" cellpadding="4">
    <thead>
    <tr>
        <th>Id</th>
        <th>Active</th>
        <th>Online</th>
        <th>Status</th>
        <th>Lat</th>
        <th>Lon</th>
        <th>Address</th>
        <th>Phone</th>
    </tr>
    </thead>
    <tbody>
    {{range .Drivers}}
    <tr>
        <td>{{.Id}}</td>
        <td>{{.Active}}</td>
        <td>{{.Online}}</td>
        <td>{{.Status}}</td>
        <td>{{.Lat}}</td>
        <td>{{.Lon}}</td>
        <td>{{.Address}}</td>
        <td>{{.Phone}}</td>
    </tr>
    {{else}}
    <tr>
        <td colspan="7">No drivers</td>
    </tr>
    {{end}}
    </tbody>
</table>

<h2>Passengers (up to 5)</h2>
<table border="1" cellpadding="4">
    <thead>
    <tr>
        <th>Id</th>
        <th>Active</th>
        <th>Online</th>
        <th>Lat</th>
        <th>Lon</th>
        <th>Address</th>
        <th>Phone</th>
    </tr>
    </thead>
    <tbody>
    {{range .Passengers}}
    <tr>
        <td>{{.Id}}</td>
        <td>{{.Active}}</td>
        <td>{{.Online}}</td>
        <td>{{.Lat}}</td>
        <td>{{.Lon}}</td>
        <td>{{.Address}}</td>
        <td>{{.Phone}}</td>
    </tr>
    {{else}}
    <tr>
        <td colspan="6">No passengers</td>
    </tr>
    {{end}}
    </tbody>
</table>

<h2>Invitations (up to 5, newest first)</h2>
<table border="1" cellpadding="4">
    <thead>
    <tr>
        <th>Id</th>
        <th>Passenger</th>
        <th>Driver</th>
        <th>Status</th>
        <th>Created</th>
        <th>Accepted</th>
        <th>Rejected</th>
        <th>Cancelled</th>
    </tr>
    </thead>
    <tbody>
    {{range .Invitations}}
    <tr>
        <td>{{.Id}}</td>
        <td>{{.PassengerId}}</td>
        <td>{{.DriverId}}</td>
        <td>{{.Status}}</td>
        <td>{{if not .CreatedAt.IsZero}}{{.CreatedAt.Format "15:04:05"}}{{end}}</td>
        <td>{{if not .AcceptedAt.IsZero}}{{.AcceptedAt.Format "15:04:05"}}{{end}}</td>
        <td>{{if not .RejectedAt.IsZero}}{{.RejectedAt.Format "15:04:05"}}{{end}}</td>
        <td>{{if not .CancelledAt.IsZero}}{{.CancelledAt.Format "15:04:05"}}{{end}}</td>
    </tr>
    {{else}}
    <tr>
        <td colspan="8">No invitations</td>
    </tr>
    {{end}}
    </tbody>
</table>

<h2>Messages (latest 15)</h2>
<table border="1" cellpadding="4">
    <thead>
    <tr>
        <th>Id</th>
        <th>Sender</th>
        <th>Receiver</th>
        <th>Text</th>
        <th>Sent</th>
    </tr>
    </thead>
    <tbody>
    {{range .Messages}}
    <tr>
        <td>{{.Id}}</td>
        <td>{{.SenderId}}</td>
        <td>{{.ReceiverId}}</td>
        <td>{{.Text}}</td>
        <td>{{if not .SentTime.IsZero}}{{.SentTime.Format "15:04:05"}}{{end}}</td>
    </tr>
    {{else}}
    <tr>
        <td colspan="5">No messages</td>
    </tr>
    {{end}}
    </tbody>
</table>

<p><a href="/observer">Refresh</a></p>
</body>
</html>
